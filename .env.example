# Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=

# PostgreSQL connection string (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=

# Optional: override default AI model (default: llama-3.3-70b-versatile)
# AI_MODEL_ID=

# Optional: custom display name shown in UI (default: Llama 3.3 70B)
# AI_MODEL_DISPLAY_NAME=

# Optional: GitHub PAT for higher doc-sync API rate limits (60/hr → 5000/hr)
# GITHUB_TOKEN=
